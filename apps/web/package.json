{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist node_modules coverage reports",
    "dev": "vite --port 5000 --strictPort",
    "fix": "eslint --cache --concurrency auto --fix",
    "lint": "bun run lint:types && bun run lint:code && bun run lint:fsd && bun run lint:unused",
    "lint:code": "eslint --cache --concurrency auto",
    "lint:dry": "jscpd .",
    "lint:fsd": "steiger ./src",
    "lint:types": "tsc --noEmit",
    "lint:unused": "knip --cache",
    "start": "vite preview --port 5000 --strictPort",
    "test": "bun run test:unit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@tanstack/react-router": "^1.114.3",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^16.0.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.9.3",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.114.3",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "jscpd": "^5.0.11",
    "knip": "^6.16.1",
    "steiger": "^0.5.13",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.8"
  }
}
