{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "clean": "rimraf dist node_modules coverage reports",
    "dev": "nest start --watch",
    "fix": "eslint --cache --concurrency auto --fix",
    "gen:migration": "drizzle-kit generate",
    "lint": "bun run lint:types && bun run lint:code && bun run lint:unused",
    "lint:code": "eslint --cache --concurrency auto",
    "lint:dry": "jscpd .",
    "lint:types": "tsc --noEmit",
    "lint:unused": "knip --cache",
    "test": "bun run test:unit && bun run test:e2e",
    "test:e2e": "vitest run --config ./test/vitest.config.e2e.ts",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.26",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@scalar/nestjs-api-reference": "^1.2.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.0",
    "express": "^5.2.1",
    "lodash": "^4.18.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.21.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.26",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.41",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.5",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-project-structure": "^3.14.3",
    "eslint-plugin-zod": "^4.5.4",
    "fishery": "^2.4.0",
    "globals": "^17.6.0",
    "jscpd": "^5.0.11",
    "knip": "^6.16.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.61.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8",
    "vitest-mock-extended": "^5.1.1"
  }
}
