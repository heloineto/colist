{
  "name": "colist",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "fix": "prettier --cache --write . && bun run fix:iac && turbo run fix",
    "fix:deps": "syncpack fix && syncpack update --target minor",
    "fix:iac": "terraform fmt -recursive iac",
    "iac:bootstrap:apply": "terraform -chdir=iac/bootstrap apply",
    "iac:bootstrap:init": "terraform -chdir=iac/bootstrap init",
    "iac:bootstrap:plan": "terraform -chdir=iac/bootstrap plan",
    "lint": "bun run lint:fmt && bun run lint:spell && bun run lint:iac && turbo run lint",
    "lint:deps": "syncpack lint || syncpack update --check",
    "lint:fmt": "prettier --cache --check .",
    "lint:iac": "terraform fmt -recursive -check iac && for dir in iac/bootstrap iac/environments/*/; do (TF_DATA_DIR=.terraform-lint terraform -chdir=\"$dir\" init -backend=false -input=false && TF_DATA_DIR=.terraform-lint terraform -chdir=\"$dir\" validate) || exit 1; done",
    "lint:spell": "cspell --cache .",
    "start:services": "docker compose --env-file .env.development.local up -d",
    "stop:services": "docker compose --env-file .env.development.local down",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.0.2",
    "@cspell/dict-es-es": "^3.0.8",
    "@cspell/dict-pt-br": "^2.4.2",
    "@types/bun": "^1.3.14",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rimraf": "6.1.3",
    "syncpack": "^15.3.1",
    "turbo": "^2.9.18",
    "validate-branch-name": "^1.3.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        150
      ]
    }
  },
  "validate-branch-name": {
    "pattern": "^(main|dev){1}$|^(feat|fix|hotfix|chore|docs|refactor|ci|test|style)(\\(.+\\))?/.+$|^dependabot/.+$",
    "errorMsg": "Branch name invalid. Format: <type>/<description>. Example: feat/add-new-feature"
  }
}
