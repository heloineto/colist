# Local Terraform working dirs and plugins
**/.terraform/*
# Scratch data dir used by `bun run lint:iac` (offline validate, never the real init)
**/.terraform-lint/

# State - lives in S3, never on disk
*.tfstate
*.tfstate.*

# Crash logs and local overrides
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep .terraform.lock.hcl committed for reproducible provider versions
